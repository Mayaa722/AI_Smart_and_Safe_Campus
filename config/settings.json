{
  "subject_profile": "stem",
  "chunk_chars": {"stem": 512, "humanities": 1000},
  "chunk_overlap": 64,

  "render_dpi": 150,
  "render_max_px": 2000,

  "embedding_model": "BAAI/bge-m3",
  "reranker_model": "BAAI/bge-reranker-v2-m3",

  "retrieval": {
    "use_dense": true,
    "use_bm25": true,
    "use_reranker": true,
    "use_descriptions": true,
    "use_context_header": true,
    "chunking": "small_to_big",
    "neighbours": 1,
    "candidates": 30,
    "top_k": 6,
    "max_evidence_slides": 12,
    "min_slides_per_question": 2,
    "rrf_k": 60,
    "gate_enabled": true,
    "gate_min_reranker_score": 0.05,
    "gate_min_dense_score": 0.35,
    "gate_retry": true,
    "gate_unsure_min_dense": 0.40
  },

  "history_turns": 6,
  "max_images": 4,
  "prompt_version": "A",
  "temperature": 0.0,

  "models": {
    "generator": "gemini-3.5-flash-lite",
    "describer": "gemini-3.5-flash-lite",
    "query": "gemini-3.5-flash-lite",
    "checker": "groq-gpt-oss-120b",
    "checker_fallback": "groq-gpt-oss-120b-key2",
    "solver_2": "openrouter-nemotron-super",
    "solver_2_fallback": "openrouter-nemotron-super-key2",
    "judge": "openrouter-nemotron-super",
    "judge_fallback": "openrouter-nemotron-super-key2"
  },

  "quiz": {"default_questions": 8, "seed": 42, "replace_withheld": true,
           "bank": {"per_content_slide": 1.0, "max_items": 30, "min_ready": 3, "near_duplicate_threshold": 0.84}},
  "summary": {"max_evidence_chars": 130000},

  "verify": {
    "enabled": true,
    "faithfulness_threshold": 0.9,
    "tutor_sample_rate": 0.25,
    "max_repairs": 1
  }
}
